CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false

# Supabase Dashboard -> Connect -> Direct connection or Session pooler.
# Use the direct connection for an IPv6-capable persistent server.
# Use the Session pooler on port 5432 for an IPv4-only persistent server.
database.default.hostname = 'db.YOUR_PROJECT_REF.supabase.co'
database.default.database = 'postgres'
database.default.username = 'postgres'
database.default.password = 'YOUR_DATABASE_PASSWORD'
database.default.DBDriver = 'Postgre'
database.default.port = 5432
database.default.connect_timeout = 5
database.default.schema = 'public'
database.default.sslmode = 'require'

# Supabase Auth and backend-only Storage integration.
# Never expose the service-role key to the frontend.
supabase.url = 'https://YOUR_PROJECT_REF.supabase.co'
supabase.anonKey = 'YOUR_PUBLISHABLE_OR_ANON_KEY'
supabase.serviceRoleKey = 'YOUR_SERVICE_ROLE_KEY'

# Security-critical evidence upload scanning.
# Production/Test deployments must install ClamAV and point this to the absolute
# clamdscan (preferred) or clamscan executable. Uploads FAIL CLOSED when the
# scanner is required but unavailable.
EVIDENCE_MALWARE_SCAN_REQUIRED = true
# Linux example: /usr/bin/clamdscan
# Windows example: C:\\Program Files\\ClamAV\\clamscan.exe
EVIDENCE_MALWARE_SCANNER_PATH = '/usr/bin/clamdscan'
