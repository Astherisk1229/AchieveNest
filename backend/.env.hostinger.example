# AchieveNest — Hostinger production environment template
# COPY THIS TO backend/.env ON THE SERVER ONLY AFTER THE MYSQL MIGRATION IS COMPLETE.
# NEVER COMMIT THE REAL .env OR REAL CREDENTIALS.

CI_ENVIRONMENT = production

# Replace with the final HTTPS application URL.
app.baseURL = 'https://YOUR_DOMAIN/'
app.forceGlobalSecureRequests = true

# Hostinger MySQL values from hPanel -> Databases -> Management.
database.default.hostname = 'HOSTINGER_DB_HOST'
database.default.database = 'HOSTINGER_DB_NAME'
database.default.username = 'HOSTINGER_DB_USER'
database.default.password = 'HOSTINGER_DB_PASSWORD'
database.default.DBDriver = 'MySQLi'
database.default.port = 3306
database.default.charset = 'utf8mb4'
database.default.DBCollat = 'utf8mb4_unicode_ci'
database.default.pConnect = false

# Frontend origin allowed to call the API.
# For a same-origin deployment this will normally be the same HTTPS domain.
CORS_ALLOWED_ORIGINS = 'https://YOUR_DOMAIN'

# Application-owned JWT signing secret used after Supabase Auth is removed.
# Generate a long random secret directly in the production secret store/server.
JWT_SECRET = 'GENERATE_ON_SERVER_DO_NOT_COMMIT'

# Production safety
logger.threshold = 4
