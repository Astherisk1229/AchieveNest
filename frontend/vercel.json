{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/login", "destination": "/index.html" },
    { "source": "/change-password", "destination": "/index.html" },
    { "source": "/403", "destination": "/index.html" },
    { "source": "/verify/:path*", "destination": "/index.html" },
    { "source": "/personnel/:path*", "destination": "/index.html" },
    { "source": "/dean/:path*", "destination": "/index.html" },
    { "source": "/department/:path*", "destination": "/index.html" },
    { "source": "/student/:path*", "destination": "/index.html" },
    { "source": "/hr/:path*", "destination": "/index.html" },
    { "source": "/osad/:path*", "destination": "/index.html" },
    { "source": "/scanner/:path*", "destination": "/index.html" },
    { "source": "/depsec", "destination": "/index.html" },
    { "source": "/coordinator", "destination": "/index.html" },
    { "source": "/org-moderator", "destination": "/index.html" },
    { "source": "/account", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" },
    { "source": "/notifications", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=(), payment=()" }
      ]
    }
  ]
}
