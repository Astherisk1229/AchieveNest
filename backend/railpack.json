{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "ocr-install": {
      "inputs": [
        { "step": "packages:mise" },
        { "local": true, "include": ["."] }
      ],
      "commands": ["sh scripts/railway-install-ocr.sh"],
      "deployOutputs": [{ "include": [".runtime/python-packages", ".runtime/paddlex-cache"] }]
    }
  }
}
