# Copy these names into Railway's service Variables. Do not commit real values.
CI_ENVIRONMENT=production
ACHIEVENEST_ENV=production

# Set this after Railway generates the backend domain. Keep the trailing slash.
app.baseURL=https://YOUR_BACKEND_DOMAIN/
# Railway terminates TLS at its proxy. Leave this false unless trusted proxy IPs
# are configured in CodeIgniter; otherwise requests can enter a redirect loop.
app.forceGlobalSecureRequests=false

# Railway MySQL service references. The namespace before the first dot must
# match the MySQL service name in Railway (the default service name is MySQL).
# Add these as reference variables so credentials rotate with the database
# service and are not copied into GitHub or pasted as plaintext.
database.defaultGroup=default
database.default.hostname=${{MySQL.MYSQLHOST}}
database.default.database=${{MySQL.MYSQLDATABASE}}
database.default.username=${{MySQL.MYSQLUSER}}
database.default.password=${{MySQL.MYSQLPASSWORD}}
database.default.DBDriver=MySQLi
database.default.port=${{MySQL.MYSQLPORT}}
database.default.charset=utf8mb4
database.default.DBCollat=utf8mb4_unicode_ci
database.default.connect_timeout=10
database.default.encrypt=false

# Local application JWTs are the active authentication implementation.
LOCAL_AUTH_JWT_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
LOCAL_AUTH_ISSUER=achievenest-production
LOCAL_AUTH_AUDIENCE=achievenest-web
LOCAL_AUTH_ACCESS_TTL_SECONDS=3600
LOCAL_AUTH_REMEMBER_TTL_SECONDS=28800

# Railpack detects PHP from composer.json. CodeIgniter's entry point is public/.
RAILPACK_PHP_ROOT_DIR=/app/public
RAILPACK_DEPLOY_APT_PACKAGES=default-mysql-client clamav clamav-freshclam tesseract-ocr poppler-utils

# Add every deployed frontend origin as a zero-based item. If the frontend and
# API are same-origin, CORS is not involved and this may remain localhost-only.
cors.default.allowedOrigins.0=https://YOUR_FRONTEND_DOMAIN

# A Railway volume must be mounted at /app/writable before accepting uploads.
# These paths are for a Linux runtime with ClamAV/Tesseract/Poppler installed.
clamav.clamscanPath=/usr/bin/clamscan
clamav.databaseDirectory=/var/lib/clamav
ocr.tesseractPath=/usr/bin/tesseract
ocr.pdfToTextPath=/usr/bin/pdftotext
ocr.pdfToPpmPath=/usr/bin/pdftoppm
