CI_ENVIRONMENT = development
ACHIEVENEST_ENV = local-defense

app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false

# ============================================================================
# Local WAMP MySQL Defense Environment Configuration
# ============================================================================
database.defaultGroup = local_defense

database.local_defense.hostname = localhost
database.local_defense.database = achievenest_local
database.local_defense.username = achievenest_app
database.local_defense.password = CHANGE_ME_LOCAL_ONLY
database.local_defense.DBDriver = MySQLi
database.local_defense.port = 3306
database.local_defense.charset = utf8mb4
database.local_defense.DBCollat = utf8mb4_unicode_ci

# Fallback default group override for MySQL
database.default.hostname = localhost
database.default.database = achievenest_local
database.default.username = achievenest_app
database.default.password = CHANGE_ME_LOCAL_ONLY
database.default.DBDriver = MySQLi
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

# ============================================================================
# Preserved Hosted PostgreSQL / Supabase Environment Configuration
# ============================================================================
database.development.hostname = 'db.YOUR_PROJECT_REF.supabase.co'
database.development.database = 'postgres'
database.development.username = 'postgres'
database.development.password = 'YOUR_DATABASE_PASSWORD'
database.development.DBDriver = 'Postgre'
database.development.port = 5432
database.development.connect_timeout = 5
database.development.schema = 'public'
database.development.sslmode = 'require'

# Reserved for Supabase Auth/JWKS and server-side Storage integration
supabase.url = 'https://YOUR_PROJECT_REF.supabase.co'
supabase.anonKey = 'YOUR_PUBLISHABLE_OR_ANON_KEY'
supabase.serviceRoleKey = 'YOUR_SERVICE_ROLE_KEY'
